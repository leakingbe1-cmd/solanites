# Solanites server configuration.
# Copy to .env.local for local development; set the same names in Vercel →
# Project → Settings → Environment Variables for deployments.
#
# None of these use the NEXT_PUBLIC_ prefix: they stay on the server and are
# never sent to the browser. Do not commit real values.

# ── Required for live wallet lookups (Phase 2) ──────────────────────────────

# The official Solanites SPL token mint address. This is the token's identity;
# a symbol or name is not. Leave empty until the official mint is confirmed —
# lookups return "not configured" instead of guessing.
SOLANITES_MINT=

# Solana JSON-RPC endpoint, including any API key. Must be https://.
# Use a dedicated provider (e.g. Helius, Triton, QuickNode) for production;
# the public endpoint is heavily rate-limited.
SOLANA_RPC_URL=

# Commitment for lookups: "confirmed" (fast, default) or "finalized".
SOLANA_COMMITMENT=confirmed

# Comma-separated wallet addresses that never earn eggs or rewards:
# treasury, team, liquidity pool, reward reserve, burn, exchange wallets.
SOLANITES_EXCLUDED_OWNERS=

# ── Optional tuning ─────────────────────────────────────────────────────────

# Lookups allowed per client IP per window (per server instance).
LOOKUP_RATE_LIMIT_MAX=20
LOOKUP_RATE_LIMIT_WINDOW_MS=60000
# How long a lookup result is reused before re-reading the chain.
LOOKUP_CACHE_MS=15000

# ── Automatic holder tracking and eggs (Workflow A) ──────────────────────────

# Postgres connection string (Neon, Supabase or any Postgres 14+). Use the
# provider's pooled endpoint on serverless hosts. Tables are created
# automatically on first use. Required for tracking; without it the egg
# endpoints answer NOT_CONFIGURED instead of showing anything made up.
DATABASE_URL=

# Protects GET/POST /api/cron/sync (the scheduled tracking pass). Send it as
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron sends this automatically.
CRON_SECRET=

# Shared secret for POST /api/webhooks/solana (e.g. a Helius webhook on the
# mint, with this value as its auth header). Optional but recommended: it
# makes new eggs appear within seconds instead of at the next scheduled pass.
SOLANITES_WEBHOOK_SECRET=

# Program-controlled owners (pool authorities, vaults: off-curve addresses)
# never earn eggs. Set to "false" only if smart-contract wallets must earn.
SOLANITES_EXCLUDE_PROGRAM_OWNERS=true

# ── Launch fee claims (Workflow B) ──────────────────────────────────────────

# Launch time (ISO 8601, UTC). Claims open six hours after it. Leave empty
# until the launch is scheduled.
SOLANITES_LAUNCH_AT=

# Domain shown in the wallet sign-in message, e.g. solanites.vercel.app.
SIWS_DOMAIN=

# HMAC secret for 15-minute claim sessions; 32+ random characters.
SOLANITES_SESSION_SECRET=

# Claim amounts additionally need an approved refund policy in code
# (src/server/claims/policy.ts). None is active, so no amount is ever quoted.

# ── Local development only ──────────────────────────────────────────────────

# SOLANITES_FIXTURES=1 runs an in-memory database and a fixture chain with
# test holders (labelled "fixture" everywhere). Refused in production.
# SOLANITES_FIXTURES=

# ── Internal Content Studio (/studio) ───────────────────────────────────────

# The promotional Content Studio is always available in development. In
# production it returns 404 unless this is set to 1. It is never linked from
# the site and is marked noindex either way.
# SOLANITES_STUDIO=
