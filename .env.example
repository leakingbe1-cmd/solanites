# Copy to .env.local and fill in to enable the (experimental) live-chain path.
# Leave empty to run fully on clearly-labelled mock data.

# SPL token mint address of the Solanites token
NEXT_PUBLIC_SOLANITES_MINT=
# Solana JSON-RPC endpoint (use a dedicated provider in production)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
